{
  "mcpServers": {
    "mise": {
      "type": "stdio",
      "command": "mise",
      "env": {
        "MISE_EXPERIMENTAL": "1"
      },
      "args": [
        "mcp"
      ]
    },
    "aspire": {
      "type": "stdio",
      "command": "aspire",
      "args": [
        "agent",
        "mcp"
      ]
    },
    "azure": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@azure/mcp@latest",
        "server",
        "start"
      ]
    }
  }
}
