{
  "SessionStart": [
    {
      "matcher": "*",
      "hooks": [
        {
          "type": "command",
          "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/azure-skills/hooks/scripts/track-telemetry.sh\""
        }
      ],
      "_apm_source": "microsoft/azure-skills"
    }
  ],
  "PostToolUse": [
    {
      "matcher": "*",
      "hooks": [
        {
          "type": "command",
          "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/azure-skills/hooks/scripts/track-telemetry.sh\""
        }
      ],
      "_apm_source": "microsoft/azure-skills"
    },
    {
      "matcher": "read_file|view|Read",
      "hooks": [
        {
          "type": "command",
          "powershell": "powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \"if(([Environment]::GetEnvironmentVariable('PLUGIN_ROOT')) -and [IO.File]::Exists([IO.Path]::Combine([Environment]::GetEnvironmentVariable('PLUGIN_ROOT'),'hooks','scripts','track-telemetry.ps1'))){& ([IO.Path]::Combine([Environment]::GetEnvironmentVariable('PLUGIN_ROOT'),'hooks','scripts','track-telemetry.ps1'))}else{Write-Output ('{'+[char]34+'continue'+[char]34+':true}')}\"",
          "command": "if [ -n \"${PLUGIN_ROOT:-}\" ] && [ -f \"${CLAUDE_PROJECT_DIR}/.claude/hooks/upgrade-agent/hooks/scripts/track-telemetry.sh\" ]; then bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/upgrade-agent/hooks/scripts/track-telemetry.sh\"; else echo '{\"continue\":true}'; fi"
        }
      ],
      "_apm_source": "microsoft/upgrade-agent-plugins/plugins/upgrade-agent"
    }
  ]
}
