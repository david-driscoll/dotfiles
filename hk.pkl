amends "package://github.com/jdx/hk/releases/download/v1.56.1/hk@1.56.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.56.1/hk@1.56.1#/Builtins.pkl"

local linters = new Mapping<String, Step> {
    ["shellcheck"] {
        glob = "**/*.{sh,bash}"
        check = "shellcheck --exclude=SC2088 --exclude=SC2086 {{files}}"
    }
    ["shfmt"] = Builtins.shfmt
    ["check-merge-conflict"] = (Builtins.check_merge_conflict) {
        batch = true
    }
    ["gitleaks"] = (Builtins.gitleaks) {
        check = "gitleaks git --pre-commit --staged --redact"
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["pre-push"] {
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["check"] {
        steps = linters
    }
}
