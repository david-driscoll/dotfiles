{#-
  Rendered into ~/.gitconfig.local by the "~/.gitconfig.local" entry in
  .config/mise/config.toml (mode = "template"), on every OS mise bootstraps.
  It only picks which tracked git/gitconfig.<flavor> file to include:

    windows -> git/gitconfig.windows  (native Windows)
    macos   -> git/gitconfig.darwin
    linux   -> git/gitconfig.wsl      (WSL: kernel release contains "microsoft")
            -> git/gitconfig.linux    (everything else: Codespaces, bare metal)

  A template rather than per-OS [dotfiles] entries because mise has no "wsl"
  platform or variant selector; os() alone would send WSL to gitconfig.linux.
  Coder workspaces replace this entry in config.coder.toml.
-#}
# Generated by mise from ~/dotfiles/git/gitconfig.local.tera; edits here are
# overwritten. Put settings for this machine only in the untracked
# ~/.gitconfig (where `git config --global` writes).
[include]
{%- if os() == "windows" %}
	path = ~/dotfiles/git/gitconfig.windows
{%- elif os() == "macos" %}
	path = ~/dotfiles/git/gitconfig.darwin
{%- elif "microsoft" in (read_file(path="/proc/sys/kernel/osrelease") | lower) %}
	path = ~/dotfiles/git/gitconfig.wsl
{%- else %}
	path = ~/dotfiles/git/gitconfig.linux
{%- endif %}
