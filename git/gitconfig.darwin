## macOS override for ~/.gitconfig.local. Deployed by mise's [dotfiles] via
## .config/mise/config.macos.toml — platform config-file layering
## (<basename>.<platform>.toml, gated by MISE_AUTO_ENV=1), the same
## mechanism PR #79 used for karabiner.json and 1Password's agent.toml. This
## is NOT a git [includeIf] — git's own conditional-include keywords are
## gitdir, gitdir/i, onbranch, and hasconfig:remote.*.url (see `git help
## config`, verified on git 2.55.0); none of them can express "this OS".
## mise's platform layering is the only mechanism in this stack that
## actually knows what OS it's running on, so it does the OS branching and
## git's [include] (unconditional) just pulls in whatever landed at the
## fixed ~/.gitconfig.local path.
##
## Identity block below (#81 review): this is David's personal mac, so it
## carries the same email/signing key/github user that used to live in the
## shared git/gitconfig — moving them here changes nothing on this machine.
## Edit THIS block if this specific mac should ever use a different
## identity; the other per-OS files (.linux/.windows/.wsl) each start from
## an identical copy for the same reason.

[user]
	email = david.driscoll@gmail.com
	# Public half of an ssh-ed25519 key, used only for commit signing
	# verification — safe to commit (public by definition).
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFEZpmeANLSx9Worwn0REmiWKLEkDvGaaz5ZlCVuRc67

[github]
	user = david-driscoll

[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
