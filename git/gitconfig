[github]
	user = david-driscoll

[core]
	eol = lf
	autocrlf = false
	editor = vi
	packedGitLimit = 512m
	packedGitWindowSize = 512m

[pack]
	deltaCacheSize = 2047m
	packSizeLimit = 2047m
	windowMemory = 2047m

[gpg]
	format = ssh

[commit]
	gpgsign = true

[pull]
	rebase = true

[tag]
	forceSignAnnotated = true

[diff "sopsdiffer"]
	# Live-only setting, referenced by .sops.yaml-adjacent diff drivers in
	# other repos (lets `git diff` show decrypted sops content). No script
	# ever set this either; carried forward since dropping it would
	# silently break sops-aware diffing anywhere it's relied on via
	# .gitattributes `diff=sopsdiffer`.
	textconv = sops -d --config /dev/null

[alias]
	amend = commit --amend --reuse-message=HEAD
	squash = "!f() { git rebase -i --autosquash $1; }; f"

# Per-OS overrides live in ~/.gitconfig.local, rendered by mise's [dotfiles]
# from git/gitconfig.local.tera (one entry in .config/mise/config.toml), which
# includes git/gitconfig.<windows|darwin|linux|wsl>. If the file doesn't exist
# yet, git silently skips the include rather than erroring.
[include]
	path = ~/.gitconfig.local

# This file isn't ~/.gitconfig itself. That is an untracked file seeded once
# by mise ([dotfiles] in .config/mise/config.toml) which includes this one
# first, so `git config --global` writes, and any settings for this machine
# only, land there and win over everything here. Don't include ~/.gitconfig
# from here: the two files would include each other in a loop.

# Global hk hooks (`mise run hk:install-global`). hk writes absolute,
# machine-specific mise paths, so they live in this untracked file rather
# than here or in the tracked per-OS ~/.gitconfig.local.
[include]
	path = ~/.config/hk/gitconfig
