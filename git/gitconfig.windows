## Native Windows override for ~/.gitconfig.local. As of #72 (setup/setup.ps1),
## this is wired up via `git config --global include.path <repo>\git\gitconfig.windows`
## in that script's "layer the Windows-only overrides" section — not through
## mise's [dotfiles] platform-layering (config.macos.toml / config.linux.toml),
## which still only covers mac + linux.
##
## Identity block below (#81 review): this is David's work Windows machine —
## the whole reason this review comment exists is that it may need a
## DIFFERENT email/signing key than his personal mac. Starting point is an
## identical copy of git/gitconfig.darwin's values so nothing changes until
## this is deliberately edited; edit THIS block for a work identity.

[user]
	email = david.driscoll@gmail.com
	# Public half of an ssh-ed25519 key, used only for commit signing
	# verification — safe to commit (public by definition).
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFEZpmeANLSx9Worwn0REmiWKLEkDvGaaz5ZlCVuRc67

[github]
	user = david-driscoll

[core]
	# git's own transport (clone/fetch/push over ssh://), distinct from the
	# gpg.ssh.program below which is only used for commit signing.
	sshCommand = C:/Windows/System32/OpenSSH/ssh.exe

[gpg "ssh"]
	program = C:/Program Files/1Password/app/8/op-ssh-sign.exe
