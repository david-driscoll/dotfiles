## Native Windows override for ~/.gitconfig.local. NOT currently wired into
## any automatic deployment mechanism: mise's [dotfiles] platform-layering
## (config.macos.toml / config.linux.toml, MISE_AUTO_ENV=1) only exists for
## mac + linux today per PR #79 — Windows dotfiles deployment is explicitly
## out of scope for #65 and tracked separately in #72 (the setup.ps1
## rewrite). This file exists so the setting survives and is ready to wire
## up once #72 lands. Until then, apply by hand on a Windows box, e.g.:
##
##   git config --global include.path "$env:USERPROFILE\dotfiles\git\gitconfig.windows"
##
## (or copy its two keys directly into a local ~/.gitconfig.local).

[core]
	# git's own transport (clone/fetch/push over ssh://), distinct from the
	# gpg.ssh.program below which is only used for commit signing.
	sshCommand = C:/Windows/System32/OpenSSH/ssh.exe

[gpg "ssh"]
	program = C:/Program Files/1Password/app/8/op-ssh-sign.exe
