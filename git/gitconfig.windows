## Native Windows overrides. Included from ~/.gitconfig.local, which mise
## renders from git/gitconfig.local.tera when os() is "windows".
##
## Identity block below (#81 review): starting point is an identical copy of
## git/gitconfig.darwin's values. For a machine that needs a different
## identity (e.g. a work email/signing key), put it in the untracked
## ~/.gitconfig instead of editing this shared file.

[core]
	# git's own transport (clone/fetch/push over ssh://), distinct from the
	# gpg.ssh.program below which is only used for commit signing.
	sshCommand = C:/Windows/System32/OpenSSH/ssh.exe

[gpg "ssh"]
	program = C:/Program Files/1Password/app/8/op-ssh-sign.exe
