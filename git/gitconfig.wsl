## WSL overrides. Included from ~/.gitconfig.local, which mise renders from
## git/gitconfig.local.tera. mise has no "wsl" platform (os() reports
## "linux"), so the template detects WSL itself: the kernel release in
## /proc/sys/kernel/osrelease contains "microsoft" on WSL 1 and 2.
##
## Identity block below (#81 review): starting point is an identical copy
## of git/gitconfig.darwin's values. Put a machine-specific identity in the
## untracked ~/.gitconfig instead of editing this shared file.

[gpg "ssh"]
	program = /mnt/c/Program Files/1Password/app/8/op-ssh-sign-wsl
