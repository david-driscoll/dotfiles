/ssh/known_hosts
Brewfile.lock.json
.DS_Store

# APM dependencies
apm_modules/

# Scratch snapshots produced by export-agents-yml.ps1 - not meant to be committed
agents.generated.yml
marketplaces.generated.yml
mcp.json.backup.*
.cache/
.claude/worktrees/
# Crew: ignore runtime state (logs, inbox, sessions)
# Note: .crew/casting/* is identity and MUST be committed to main, not ignored
.crew/orchestration-log/
.crew/log/
.crew/decisions/inbox/
.crew/sessions/
.crew/.scratch/
.crew/.cache/
# Crew: state owned by crew-state branch (two-layer/orphan backend)
.crew/decisions.md
.crew/agents/*/history.md
# /Crew: state owned by crew-state branch
# Crew: SubCrew activation file (local to this machine)
.crew-workstream
# Squad: ignore runtime state (logs, inbox, sessions)
# Note: .squad/casting/* is identity and MUST be committed to main, not ignored
.squad/orchestration-log/
.squad/log/
.squad/decisions/inbox/
.squad/sessions/
.squad/.scratch/
.squad/.cache/
# Squad: state owned by squad-state branch (two-layer/orphan backend)
.squad/decisions.md
.squad/agents/*/history.md
# /Squad: state owned by squad-state branch
# Squad: SubSquad activation file (local to this machine)
.squad-workstream
